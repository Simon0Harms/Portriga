# Portriga Matrix-Bot – Konfiguration
# Kopieren nach /opt/portriga/matrix/portriga-matrix.env und Werte eintragen:
#   install -m 600 -o portriga -g portriga env.example /opt/portriga/matrix/portriga-matrix.env
# Kommentare in eigenen Zeilen.

# --- Pflicht ---
PORTRIGA_MATRIX_HOMESERVER=https://matrix.example.org
# Muss identisch mit accounts.botMxid (config.json) bzw. MATRIX_BOT_MXID der Node-App sein
PORTRIGA_MATRIX_USER=@portrigabot:example.org
# Nur beim ERSTEN Start nötig – danach wird ein Access-Token gespeichert und das
# Passwort sollte wieder entfernt werden.
PORTRIGA_MATRIX_PASSWORD=BitteHierDasBotPasswort

# --- Pfade (Standardwerte passen zur Node-App) ---
PORTRIGA_DATA_DIR=/opt/portriga/data
#PORTRIGA_OUTBOX_DIR=/opt/portriga/data/matrix-outbox
#PORTRIGA_INBOX_DIR=/opt/portriga/data/matrix-inbox
# E2EE-Schlüsselspeicher (unbedingt sichern!)
PORTRIGA_MATRIX_STORE=/opt/portriga/matrix-store

# --- Verhalten (optional) ---
# 1 = Antworten/Login-Links nur in E2E-verschlüsselte Chats senden (empfohlen).
# Element & Co. verschlüsseln neue Direktnachrichten standardmäßig.
PORTRIGA_REQUIRE_ENCRYPTION=1
# Long-Poll je Sync in ms (bestimmt die Reaktionszeit bei Registrierungen)
PORTRIGA_SYNC_TIMEOUT_MS=10000
# Nachrichten älter als X Sekunden ignorieren
PORTRIGA_MAX_EVENT_AGE=1800
PORTRIGA_MATRIX_DEVICE_NAME=Portriga-Bot
