# Beispiel-Umgebung für den Portriga-Dienst.
# Kopieren nach /opt/portriga/portriga.env und Werte anpassen; die systemd-Unit
# bindet diese Datei optional über EnvironmentFile ein.

PORT=3000

# STUN (Standard reicht oft für Verbindungen ohne strenges NAT):
#STUN_URL=stun:stun.l.google.com:19302

# TURN (empfohlen, damit Voice auch hinter NAT/CGNAT zuverlässig funktioniert).
# Muss mit der coturn-Konfiguration (user=... / realm=...) übereinstimmen:
#TURN_URL=turn:deine-domain.de:3478
#TURN_USER=portriga
#TURN_PASS=CHANGE_ME

# --- Benutzerkonten (Registrierung per Matrix-DM) ---
# Matrix-Bot, dem neue User ihren Code schreiben (leer/auskommentiert = Konten aus).
# Muss mit PORTRIGA_MATRIX_USER des Sidecars übereinstimmen.
#MATRIX_BOT_MXID=@portrigabot:example.org
# Öffentliche URL inkl. Basis-Pfad – Pflicht für Login-Links per Matrix.
#PORTRIGA_PUBLIC_URL=https://spiel.example.org
# Datenverzeichnis (accounts.json, secret.key, matrix-inbox/-outbox)
#PORTRIGA_DATA_DIR=/opt/portriga/data
# Nur für lokalen Test ohne HTTPS auf false setzen
#COOKIE_SECURE=true

# --- Ankündigungsraum (neue öffentliche/Ranglisten-Spiele) ---
# Öffentlicher Matrix-Raum, in den der Bot neue Spiele postet (!id:server oder #alias:server).
# Muss mit PORTRIGA_ANNOUNCE_ROOM des Sidecars übereinstimmen. Leer = aus.
#PORTRIGA_ANNOUNCE_ROOM=#portriga-spiele:example.org
# Optionaler Link für die Werbung in der App (Standard: https://matrix.to/#/<Raum>)
#PORTRIGA_ANNOUNCE_LINK=https://matrix.to/#/#portriga-spiele:example.org
