# Beispiel-Umgebung für den Portriga-Dienst.
# Kopieren nach /opt/portriga/portriga.env und Werte anpassen; die systemd-Unit
# bindet diese Datei optional über EnvironmentFile ein.

PORT=3000

# STUN (Standard reicht oft für Verbindungen ohne strenges NAT):
#STUN_URL=stun:stun.l.google.com:19302

# TURN (empfohlen, damit Voice auch hinter NAT/CGNAT zuverlässig funktioniert).
# Muss mit der coturn-Konfiguration (user=... / realm=...) übereinstimmen:
#TURN_URL=turn:deine-domain.de:3478
#TURN_USER=portriga
#TURN_PASS=CHANGE_ME
